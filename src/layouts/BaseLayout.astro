---
import "../styles/global.css";
import Footer from '../components/Footer.astro';
import BaseHead from '../components/BaseHead.astro';
import Giscus from '../components/Giscus.astro';

interface Props {
  pageTitle: string;
  description?: string;
  image?: string;
  showComments?: boolean;
}
const { pageTitle, description, image, showComments = false } = Astro.props;
---
<html lang="zh-CN">
    <head>
        <BaseHead title={pageTitle} description={description} image={image} />
    </head>

    <body style="display: flex; flex-direction: column; min-height: 100vh; margin:0;">
        <div class="container" style="flex:1;">
            
            <!-- ================= 修改开始：新的导航栏 ================= -->
            <nav style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; border-bottom: 1px solid #eaeaea; padding-bottom: 10px;">
                
                <!-- 左侧：原本的文字导航链接，用一个 div 包裹起来横向排列 -->
                <div style="display: flex; gap: 20px;">
                    <a href="/">Home</a>
                    <a href="/blog">Blog</a>
                    <a href="/moments">随笔</a>
                    <a href="/guestbook">留言板</a>
                </div>

                <!-- 右侧：RSS SVG 按钮 -->
                <a href="/rss.xml" target="_blank" title="RSS 订阅" style="display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: 4px; transition: background-color 0.2s ease; color: #666;" onmouseover="this.style.backgroundColor='#f9f9f9'" onmouseout="this.style.backgroundColor='transparent'">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4 11a9 9 0 0 1 9 9"></path>
                        <path d="M4 4a16 16 0 0 1 16 16"></path>
                        <circle cx="5" cy="19" r="1"></circle>
                    </svg>
                </a>
                
            </nav>
            <!-- ================= 修改结束 ================= -->

            <main>
                <slot />
                {showComments && <Giscus />}
            </main>
        </div>

        <Footer />

    </body>

    <!-- ==================== Umami 统计代码 ==================== -->
    <script is:inline>
      const isLocal = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1';
      const isOwner = localStorage.getItem('ignore_analytics') === 'true';
      if (!isLocal && !isOwner) {
        const script = document.createElement('script');
        script.defer = true;
        script.src = 'https://cloud.umami.is/script.js';
        script.setAttribute('data-website-id', 'b2490c6f-ff99-459a-9657-a3b886914748');
        document.head.appendChild(script);
      } else {
        console.log('【Umami】开发环境或管理员访问，统计已静默拦截。');
      }
    </script>

    <style is:global>
      main img {
        max-width: 100% !important;
        height: auto !important;
        display: block;
        margin: 1.5rem auto; /* 保证图片居中，并与上下文字保持间距 */
        border-radius: 8px;  /* 可选：为图片添加轻微圆角 */
      }
    </style>


</html>

